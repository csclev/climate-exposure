baselines
# For L2 mid tier
df_l2_mid <- baselines$level2$df |> filter(tier == "mid")
# Median market cap per county (approximate)
median_zhvi <- median(df_l2_mid$zhvi_t0, na.rm = TRUE)  # need T=0 ZHVI
# If not available, use the snapshot
median_units <- median(df_l2_mid$total_units, na.rm = TRUE)
median_market_cap <- median_zhvi * median_units / 3
# Pre-trend effect in dollar terms
# CIR is in index points (base 100)
# Median CIR ≈ 1-2 index points
# That's ~1-2% of T=0 value
median_cir <- median(df_l2_mid$auc, na.rm = TRUE)
dollar_effect <- median_market_cap * (median_cir / 100)
# Compare to median EAL
median_eal <- median(df_l2_mid$eal_valt, na.rm = TRUE)
cat(sprintf("Median county market cap (est): $%s\n", format(round(median_market_cap), big.mark = ",")))
cat(sprintf("Median CIR: %.2f index points\n", median_cir))
cat(sprintf("Implied market movement: $%s\n", format(round(dollar_effect), big.mark = ",")))
cat(sprintf("Median NRI EAL: $%s/year\n", format(round(median_eal), big.mark = ",")))
cat(sprintf("Ratio (market movement / EAL): %.1fx\n", dollar_effect / median_eal))
baseliens
baselines
median_zhvi <- median(df_l2_mid$zhvi_t0, na.rm = TRUE)
median_units <- median(df_l2_mid$total_units, na.rm = TRUE)
# ZHVI at T=0 from event_neighbors
en <- read_csv(here::here("data", "processed", "nlevel2_nmin2_pre3_post9", "event_neighbors_mid.csv"),
col_types = cols(target_fips = col_character()),
show_col_types = FALSE)
median_zhvi_t0 <- median(en$target_zhvi_t0, na.rm = TRUE)
# Housing units from ACS
acs_units <- get_acs(
geography = "county",
variables = c(total_units = "B25001_001"),
year = 2023, survey = "acs5", output = "wide",
cache_table = TRUE
) |>
transmute(stcofips = GEOID, total_units = total_unitsE)
# Match to study counties
study_counties <- unique(baselines$level2$df |> filter(tier == "mid") |> pull(stcofips))
median_units <- median(acs_units$total_units[acs_units$stcofips %in% study_counties], na.rm = TRUE)
# Market cap estimate (per tier = 1/3 of units)
median_market_cap <- median_zhvi_t0 * median_units / 3
# CIR in dollar terms
median_cir <- median(baselines$level2$df |> filter(tier == "mid") |> pull(auc), na.rm = TRUE)
dollar_effect <- median_market_cap * (median_cir / 100)
cat(sprintf("Median ZHVI at T=0: $%s\n", format(round(median_zhvi_t0), big.mark = ",")))
cat(sprintf("Median housing units: %s\n", format(median_units, big.mark = ",")))
cat(sprintf("Est. tier market cap: $%s\n", format(round(median_market_cap), big.mark = ",")))
cat(sprintf("Median CIR: %.2f index points\n", median_cir))
cat(sprintf("Implied market movement per county: $%s\n", format(round(dollar_effect), big.mark = ",")))
