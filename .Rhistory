# Check if pre-storm deviations are significantly different from zero
baselines$level2$monthly_dev |>
filter(tier == "mid", month_t %in% c(-3, -2, -1)) |>
group_by(month_t) |>
summarise(
mean_dev = mean(deviation, na.rm = TRUE),
se_dev   = sd(deviation, na.rm = TRUE) / sqrt(n()),
t_stat   = mean_dev / se_dev,
p_value  = 2 * pt(-abs(t_stat), df = n() - 1),
.groups  = "drop"
)
