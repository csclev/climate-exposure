# Direct download from USDA ERS
rucc_url <- "https://www.ers.usda.gov/sites/default/files/_laserfiche/DataFiles/53251/Ruralurbancontinuumcodes2023.xlsx"
rucc_file <- "../data/raw/rucc.xlsx"
download.file(rucc_url, destfile = rucc_file, mode = "wb")
rucc <- read_excel(rucc_file, sheet = 1) %>%
transmute(
stcofips = sprintf("%05d", as.integer(FIPS)),
rucc_2023 = as.integer(RUCC_2023),
# metro_nonmetro = ifelse(rucc_2023 <= 3, "metro", "nonmetro") make binary
)
hed_df <- hed %>% inner_join(rucc, by = "stcofips")
